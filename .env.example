# HunterPie Analytics — copy to `.env` and adjust as needed.

# Where hunt JSON dumps live (HunterPie fork and/or the REFramework mod).
# Used by `docker compose` and `import.sh`. Defaults to ./seeds (demo data).
# When set, this overrides the dashboard's "Hunt exports folders" setting.
HUNT_EXPORTS=./seeds

# API port. The dashboard reaches it via NEXT_PUBLIC_API_URL.
PORT=8000

# SQLite database path (relative to the repo root).
HUNTS_DB=backend/hunts.db
